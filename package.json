{
  "name": "ai-broadcast-studio",
  "private": true,
  "version": "1.0.0",
  "description": "AIテレビ番組風実況動画プレイヤー（音声読み上げ＋リアルタイムテロップ演出）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "server": "node server.js",
    "start": "node server.js",
    "tunnel": "bin\\cloudflared.exe tunnel --url http://localhost:3001",
    "online": "node start-online.js",
    "build": "vite build && node scripts/write-game-config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "msedge-tts": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.7.0",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.33"
  }
}
