rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /timetables/{classId} {
      allow read, write: if classId in ['1-1', '1-2', '1-3', '1-4', '1-5', '1-6', '1-7', '1-8'];
    }

    // Hinata chat: each authenticated user can access only their own data.
    match /hinataUsers/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // sunsun study-battle shared state (real-time sync for school networks)
    match /appState/{docId} {
      allow read, write: if request.auth != null;
    }

    match /appPresence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
